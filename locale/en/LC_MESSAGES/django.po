#: .\mainview\templates\desktop\about.html:9
msgid "Inter Cargo - Информация о компании"
msgstr "Inter Cargo - About the Company"

#: .\mainview\templates\desktop\about.html:30
#: .\mainview\templates\desktop\about.html:41
#: .\mainview\templates\desktop\education1.html:132
#: .\mainview\templates\desktop\index.html:174
#: .\mainview\templates\desktop\index.html:337
#: .\mainview\templates\shared\footer.html:28
#: .\mainview\templates\shared\header.html:41
