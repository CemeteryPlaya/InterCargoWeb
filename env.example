# ─────────────────────────────────────────────────────────────────────
# Inter Cargo (cargointer.kz) — переменные окружения
# Скопируйте в .env и заполните:  cp env.example .env
# .env в git не коммитится. Здесь — только имена и безопасные примеры.
#
# Обязательные для прода помечены [ОБЯЗ.]. Закомментированные — необязательные,
# справа значение по умолчанию из cargo/settings.py.
# Локально без .env manage.py сам берёт cargo.settings_dev (SQLite, DEBUG=True).
# ─────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────
# [ОБЯЗ.] Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# true только локально
DJANGO_DEBUG=False
# [ОБЯЗ.] Через запятую, без пробелов
DJANGO_ALLOWED_HOSTS=cargointer.kz,www.cargointer.kz
# Какие настройки грузить (по умолчанию cargo.settings; без .env — cargo.settings_dev)
# DJANGO_SETTINGS_MODULE=cargo.settings
# [ОБЯЗ.] Абсолютный адрес сайта: ссылки в Telegram-боте и уведомления банков об оплате
SITE_URL=https://cargointer.kz

# ── База данных PostgreSQL ── [ОБЯЗ.] ────────────────────────────────
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Почта (SMTP Gmail: smtp.gmail.com:587, TLS) ──────────────────────
# [ОБЯЗ.] Ящик-отправитель; он же получает письма об ошибках (ADMINS)
EMAIL_HOST_USER=
# [ОБЯЗ.] Пароль приложения Google (не пароль от аккаунта)
EMAIL_HOST_PASSWORD=
# Письма администраторам о 500-ошибках
# ERROR_EMAILS=true

# ── Web-push (VAPID) ── [ОБЯЗ.] ──────────────────────────────────────
# Сгенерировать пару: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@cargointer.kz

# ── Telegram-бот (python manage.py run_bot) ── [ОБЯЗ.] ───────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @
TELEGRAM_BOT_USERNAME=

# ── Эквайринг: общее ─────────────────────────────────────────────────
# Какие эквайеры описаны на сайте (оферта, «Оплата», логотипы): halyk, freedom
# PAYMENT_PROVIDERS=halyk
# Адрес сайта для уведомлений банков, если отличается от SITE_URL
# EPAY_SITE_URL=

# ── Halyk ePay ───────────────────────────────────────────────────────
# Кнопка оплаты через Halyk
EPAY_ENABLED=false
# true — тестовый контур и публичные тестовые ключи; false — боевой терминал
EPAY_TEST_MODE=true
# Боевые реквизиты из кабинета ePay (при EPAY_TEST_MODE=true можно не задавать)
EPAY_CLIENT_ID=
EPAY_CLIENT_SECRET=
EPAY_TERMINAL_ID=
# Логотипы карт в футере — только принятые по договору
# EPAY_CARD_BRANDS=visa,mastercard,unionpay,amex

# ── Freedom Pay ──────────────────────────────────────────────────────
# Вариант оплаты через Freedom Pay
FREEDOM_ENABLED=false
# true — платежи с pg_testing_mode=1 (деньги не списываются)
FREEDOM_TEST_MODE=true
# Из личного кабинета Freedom Pay → настройки магазина
FREEDOM_MERCHANT_ID=
# Секретный ключ для ПРИЁМА платежей (не ключ для выплат)
FREEDOM_SECRET_KEY=
# Юрлицо платёжной организации из договора — выводится в оферте и политике
FREEDOM_LEGAL_NAME=
# FREEDOM_API_URL=https://api.freedompay.kz

# ── Реквизиты продавца (страницы «Покупателям», оферта) ──────────────
# Значения по умолчанию — реквизиты ИП в cargo/settings.py (COMPANY_INFO).
# Задавайте, только если они изменились.
# COMPANY_BRAND=Inter Cargo
# COMPANY_LEGAL_NAME=
# COMPANY_IIN=
# COMPANY_COUNTRY=Республика Казахстан
# COMPANY_CITY=Тараз
# COMPANY_LEGAL_ADDRESS=
# COMPANY_ACTUAL_ADDRESS=
# COMPANY_SCHEDULE=09:00–21:00
# COMPANY_PHONE_DIRECTOR=
# COMPANY_PHONE_SUPPORT=
# Только цифры, для ссылки wa.me
# COMPANY_WHATSAPP=
# COMPANY_EMAIL=
# COMPANY_VAT_PAYER=false
# Банковские реквизиты. Без COMPANY_IBAN блок банка на сайт не выводится
# (Freedom Pay требует р/с — проверка manage.py check, mainview.W008).
COMPANY_IBAN=
# COMPANY_BANK_NAME=АО «Народный Банк Казахстана»
# COMPANY_BIK=HSBKKZKX
# COMPANY_BANK_BIN=
# COMPANY_OKPO=

# ── Видеоуроки (пусто — кнопка «Смотреть видео» скрыта) ──────────────
# Ссылки t.me/c/… (закрытый канал) видят только вошедшие клиенты
# EDU_VIDEO_REGISTRATION=
# EDU_VIDEO_ORDER=
# EDU_VIDEO_TRACKING=

# ── Валидатор целостности чеков (myprofile/execution_validator) ──────
# EXECUTION_VALIDATOR_ENABLED=true
# false — CRITICAL-нарушения не блокируют операцию (только журнал)
# EXECUTION_VALIDATOR_STRICT=true

# ── Только для разработки (cargo.settings_dev) ───────────────────────
# Домен ngrok для проверки колбэков банков на локальной машине
# NGROK_HOST=
