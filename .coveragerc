[run]
source = myprofile,register,tgbot,mainview,cargo
omit =
    */migrations/*
    */tests/*
    */tests.py
    */__init__.py
    cargo/wsgi.py
    cargo/asgi.py
    cargo/settings*.py
    manage.py
    test_delivery_perf.py
    _*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
